<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/counter_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/add_button"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:contentDescription="@string/add_counter"
            android:minWidth="64dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:background="@drawable/toolbar_button_background"
            android:text="@string/add" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/toolbar_menu_button"
            android:layout_width="36dp"
            android:layout_height="26dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/toolbar_button_background"
            android:contentDescription="@string/toolbar_menu"
            android:gravity="center"
            android:paddingBottom="3dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_more_vertical" />
    </LinearLayout>

    <TextView
        android:id="@+id/error_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:textColor="@color/counter_negative"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/empty_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="12dp"
        android:text="@string/no_counters"
        android:textColor="@android:color/white" />

    <ListView
        android:id="@+id/counter_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#55FFFFFF"
        android:dividerHeight="1dp"
        android:paddingTop="4dp"
        android:scrollbars="vertical" />
</LinearLayout>
